<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('partials/head', { title: 'Error' }) %>
  </head>
  <body class="bg-light">
    <%- include('partials/navbar') %>
    <main class="container page-shell py-5">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="card error-card">
            <div class="card-body text-center p-5">
              <div class="error-icon mb-4">
                <i class="bi bi-exclamation-triangle"></i>
              </div>
              <div class="page-eyebrow">Estado <%= status %></div>
              <h1 class="h3 mb-3">Algo no salió como esperábamos</h1>
              <p class="lead mb-4"><%= error %></p>
              <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a href="/" class="btn btn-primary">Inicio</a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Volver</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
