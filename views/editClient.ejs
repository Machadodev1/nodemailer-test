<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Editar Cliente</title>
  </head>
  <body>
    <h1>Editar Cliente</h1>
    <p><a href="/clients">Volver a clientes</a></p>
    <% if (typeof error !== 'undefined') { %>
      <p style="color:red"><%= error %></p>
    <% } %>
    <form action="/clients/<%= cliente._id %>/update" method="post">
      <div>
        <label>Nombre:</label>
        <input type="text" name="nombre" value="<%= cliente.nombre %>" required />
      </div>
      <div>
        <label>Correo:</label>
        <input type="email" name="correo" value="<%= cliente.correo %>" required />
      </div>
      <div>
        <label>Teléfono:</label>
        <input type="text" name="telefono" value="<%= cliente.telefono %>" required />
      </div>
      <div>
        <button type="submit">Actualizar</button>
      </div>
    </form>
  </body>
</html>
