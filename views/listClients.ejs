<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('partials/head', { title: 'Clientes' }) %>
  </head>
  <body class="bg-light">
    <%- include('partials/navbar') %>
    <main class="container page-shell">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div><div class="page-eyebrow">Directorio</div><h1 class="page-heading">Clientes</h1><p class="page-description">Consulta y administra la información de tu cartera.</p></div>
        <a href="/clients/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo cliente</a>
      </div>

      <div class="card data-card">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table id="clientsTable" class="table table-hover mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Nombre</th>
                  <th>Correo</th>
                  <th>Teléfono</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% clients.forEach(function(c) { %>
                  <tr>
                    <td><%= c.nombre %></td>
                    <td><%= c.correo %></td>
                    <td><%= c.telefono %></td>
                    <td>
                      <div class="d-flex gap-2">
                        <a href="/clients/<%= c._id %>/edit" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i><span class="visually-hidden">Editar</span></a>
                        <form action="/clients/<%= c._id %>/delete" method="post" class="d-inline">
                          <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar este cliente?')"><i class="bi bi-trash3"></i><span class="visually-hidden">Eliminar</span></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        $('#clientsTable').DataTable({
          language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
          },
          pageLength: 10,
          order: [[0, 'asc']]
        });
      });
    </script>
  </body>
</html>
