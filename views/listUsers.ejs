<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Usuarios</title>
  </head>
  <body>
    <h1>Usuarios</h1>
    <p><a href="/">Inicio</a> | <a href="/users/new">Nuevo Usuario</a></p>
    <table border="1" cellpadding="6">
      <thead>
        <tr>
          <th>Correo</th>
          <th>Rol</th>
          <th>Creado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.correo %></td>
            <td><%= u.rol %></td>
            <td><%= new Date(u.createdAt).toLocaleString() %></td>
            <td>
              <a href="/users/<%= u._id %>/edit">Editar</a>
              <form action="/users/<%= u._id %>/delete" method="post" style="display:inline">
                <button type="submit" onclick="return confirm('Eliminar usuario?')">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </body>
</html>
