<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('partials/head', { title: 'Registro' }) %>
  </head>
  <body class="bg-light">
    <%- include('partials/navbar') %>
    <main class="container page-shell py-5">
      <div class="card form-card">
        <div class="card-body">
          <div class="error-icon mb-3"><i class="bi bi-check2"></i></div>
          <div class="page-eyebrow">Registro completado</div>
          <h1 class="h3 mb-3">Todo está listo</h1>
          <div class="alert alert-secondary"><%= message %></div>

          <% if (typeof setupError !== 'undefined' && setupError) { %>
            <h3 class="h5">Info de setup (fallback):</h3>
            <pre class="bg-light border rounded p-3 text-warning"><%= setupError %></pre>
          <% } %>

          <% if (typeof mailError !== 'undefined' && mailError) { %>
            <h3 class="h5 text-danger">Error enviando correo:</h3>
            <pre class="bg-light border rounded p-3 text-danger"><%= mailError %></pre>
          <% } %>

          <% if (typeof previewUrl !== 'undefined' && previewUrl) { %>
            <h3 class="h5">Previsualización del correo (Ethereal):</h3>
            <p><a href="<%= previewUrl %>" target="_blank"><%= previewUrl %></a></p>
          <% } %>

          <% if (typeof rawMessage !== 'undefined' && rawMessage) { %>
            <h3 class="h5">Contenido del correo (local):</h3>
            <pre class="bg-light border rounded p-3"><%= rawMessage %></pre>
          <% } %>

          <% if (typeof mailInfo !== 'undefined' && mailInfo) { %>
            <h3 class="h5">Info del envío:</h3>
            <pre class="bg-light border rounded p-3"><%= mailInfo %></pre>
          <% } %>

          <a href="/" class="btn btn-primary mt-3">Volver al inicio <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
    </main>
  </body>
</html>
